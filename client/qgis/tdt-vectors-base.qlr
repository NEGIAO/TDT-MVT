                          <Option type="bool" name="active" value="true"/>
                          <Option type="QString" name="expression" value="array_to_string(array_foreach(array(2,2),@element * (CASE WHEN @vector_tile_zoom >= 6 AND @vector_tile_zoom &lt;= 7 THEN scale_linear(@vector_tile_zoom,6,7,1.25,1.5) WHEN @vector_tile_zoom > 7 AND @vector_tile_zoom &lt;= 8 THEN 1.5 WHEN @vector_tile_zoom > 8 AND @vector_tile_zoom &lt;= 9 THEN 1.5 WHEN @vector_tile_zoom > 9 AND @vector_tile_zoom &lt;= 10 THEN 1.5 WHEN @vector_tile_zoom > 10 THEN 1.5 END)), ';')"/>
                          <Option type="int" name="type" value="3"/>
                        </Option>
                        <Option type="Map" name="enabled">
                          <Option type="bool" name="active" value="true"/>
                          <Option type="QString" name="expression" value="(CASE WHEN @vector_tile_zoom >= 6 AND @vector_tile_zoom &lt;= 7 THEN scale_linear(@vector_tile_zoom,6,7,1.25,1.5) WHEN @vector_tile_zoom > 7 AND @vector_tile_zoom &lt;= 8 THEN 1.5 WHEN @vector_tile_zoom > 8 AND @vector_tile_zoom &lt;= 9 THEN 1.5 WHEN @vector_tile_zoom > 9 AND @vector_tile_zoom &lt;= 10 THEN 1.5 WHEN @vector_tile_zoom > 10 THEN 1.5 END) > 0"/>
                          <Option type="int" name="type" value="3"/>
                        </Option>
                        <Option type="Map" name="outlineWidth">
                          <Option type="bool" name="active" value="true"/>
                          <Option type="QString" name="expression" value="CASE WHEN @vector_tile_zoom >= 6 AND @vector_tile_zoom &lt;= 7 THEN scale_linear(@vector_tile_zoom,6,7,1.25,1.5) WHEN @vector_tile_zoom > 7 AND @vector_tile_zoom &lt;= 8 THEN 1.5 WHEN @vector_tile_zoom > 8 AND @vector_tile_zoom &lt;= 9 THEN 1.5 WHEN @vector_tile_zoom > 9 AND @vector_tile_zoom &lt;= 10 THEN 1.5 WHEN @vector_tile_zoom > 10 THEN 1.5 END"/>
                          <Option type="int" name="type" value="3"/>
                        </Option>
                      </Option>
                      <Option type="QString" name="type" value="collection"/>
                    </Option>
