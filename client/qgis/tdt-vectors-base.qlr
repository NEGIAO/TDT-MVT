                          <Option type="QString" name="expression" value="(CASE WHEN @vector_tile_zoom >= 15 AND @vector_tile_zoom &lt;= 16 THEN scale_linear(@vector_tile_zoom,15,16,5,7) WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 17 THEN scale_linear(@vector_tile_zoom,16,17,7,9) WHEN @vector_tile_zoom > 17 AND @vector_tile_zoom &lt;= 18 THEN scale_linear(@vector_tile_zoom,17,18,9,10) WHEN @vector_tile_zoom > 18 THEN 10 END) > 0"/>
                          <Option type="int" name="type" value="3"/>
                        </Option>
                        <Option type="Map" name="fillColor">
                          <Option type="bool" name="active" value="true"/>
                          <Option type="QString" name="expression" value="CASE WHEN @vector_tile_zoom &lt; 15 THEN color_hsla(46, 35, 78, 255) WHEN @vector_tile_zoom >= 15 AND @vector_tile_zoom &lt; 16 THEN color_hsla(scale_linear(@vector_tile_zoom,15,16,46,47), scale_linear(@vector_tile_zoom,15,16,35,40), scale_linear(@vector_tile_zoom,15,16,78,77), 255) WHEN @vector_tile_zoom >= 16 AND @vector_tile_zoom &lt; 17 THEN color_hsla(47, 40, 77, 255) WHEN @vector_tile_zoom >= 17 AND @vector_tile_zoom &lt; 18 THEN color_hsla(47, 40, 77, 255) WHEN @vector_tile_zoom >= 18 THEN color_hsla(47, 40, 77, 255) ELSE color_hsla(47, 40, 77, 255) END"/>
                          <Option type="int" name="type" value="3"/>
                        </Option>
                        <Option type="Map" name="outlineColor">
                          <Option type="bool" name="active" value="true"/>
