                      <Option type="QString" name="expression" value="CASE WHEN @vector_tile_zoom &lt; 11 THEN color_hsla(45, 100, 81, 255) WHEN @vector_tile_zoom >= 11 AND @vector_tile_zoom &lt; 12 THEN color_hsla(45, 100, 81, 255) WHEN @vector_tile_zoom >= 12 AND @vector_tile_zoom &lt; 13 THEN color_hsla(45, 100, 81, 255) WHEN @vector_tile_zoom >= 13 AND @vector_tile_zoom &lt; 14 THEN color_hsla(scale_linear(@vector_tile_zoom,13,14,45,47), 100, scale_linear(@vector_tile_zoom,13,14,81,70), 255) WHEN @vector_tile_zoom >= 14 THEN color_hsla(47, 100, 70, 255) ELSE color_hsla(47, 100, 70, 255) END"/>
