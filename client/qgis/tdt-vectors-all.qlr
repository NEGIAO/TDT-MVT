                        <Option type="Map" name="customDash">
                          <Option type="bool" name="active" value="true"/>
                          <Option type="QString" name="expression" value="array_to_string(array_foreach(CASE WHEN @vector_tile_zoom &lt;= 16 THEN array(1,1) WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 17 THEN array(1,1) WHEN @vector_tile_zoom > 17 AND @vector_tile_zoom &lt;= 18 THEN array(1,1) WHEN @vector_tile_zoom > 18 THEN array(1,1) END,@element * (CASE WHEN @vector_tile_zoom >= 15 AND @vector_tile_zoom &lt;= 16 THEN scale_linear(@vector_tile_zoom,15,16,5,7) WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 17 THEN scale_linear(@vector_tile_zoom,16,17,7,9) WHEN @vector_tile_zoom > 17 AND @vector_tile_zoom &lt;= 18 THEN scale_linear(@vector_tile_zoom,17,18,9,10) WHEN @vector_tile_zoom > 18 THEN 10 END)), ';')"/>
                          <Option type="int" name="type" value="3"/>
