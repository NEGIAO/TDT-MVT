# 天地图标准 MVT 服务环境变量配置文件示例
# 复制此文件为 .env 即可生效: cp .env.example .env

# 服务监听端口 (默认 8890)
PORT=8890

# 天地图官方开发者密钥 (Token / TK)
# 可前往天地图开放平台 (https://console.tianditu.gov.cn/api/key) 申请服务端或浏览器端 Key
TDT_TK=b88bfb160c81dab8d9d20aaa74846360

# 外部公开访问域名或反代基址 (可选，用于自动生成正确的样式与 TileJSON URL)
# 例如: https://mvt.your-domain.com
# 若留空，则自动按访问请求头的 Host 生成
# PUBLIC_HOST=https://mvt.your-domain.com

# 是否启用本地磁盘切片缓存 (true / false，默认 true)
ENABLE_CACHE=true
